# ─────────────────────────────────────────────────────────────────────
# VerbalIA · Plantilla de variables de entorno
#
# Copia este archivo como «.env» y rellena solo lo que uses.
# El juego base funciona 100 % local; estas variables son para la
# CAPA ONLINE (cuentas y sincronización · Ola 0-1).
# ─────────────────────────────────────────────────────────────────────

# Base de datos Postgres del servidor (Neon). NO commitear nunca.
DATABASE_URL="postgresql://usuario:password@host/neondb?sslmode=require"

# URL pública de la app: se usa para los enlaces de los correos.
# Local: http://localhost:3000 · Producción: https://verbalia.vercel.app
APP_URL="http://localhost:3000"

# Envío de correos con Resend (sin SDK, vía fetch).
# Sin RESEND_API_KEY el mailer entra en modo dry-run: registra el correo
# en los logs del servidor en vez de enviarlo (útil en desarrollo).
# RESEND_API_KEY="re_..."
MAIL_FROM="Verbalia <onboarding@resend.dev>"

# Secreto para proteger tareas programadas / webhooks (Ola 2 · cron)
# CRON_SECRET=
