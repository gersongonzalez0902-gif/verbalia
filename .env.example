# ─────────────────────────────────────────────────────────────────────
# VerbalIA · Plantilla de variables de entorno
#
# Copia este archivo como «.env» y rellena solo lo que uses.
# HOY NO HACE FALTA NINGUNA: el juego es 100 % local (offline-first),
# los datos viven en el dispositivo y Vercel solo reparte los archivos.
# ─────────────────────────────────────────────────────────────────────

# Base de datos del servidor (reservado para el futuro; hoy no se usa)
# DATABASE_URL=

# URL pública de la app (ej.: la que asigne Vercel al desplegar)
# APP_URL=

# Envío de correos con Resend (reservado para el futuro; hoy no se usa)
# RESEND_API_KEY=
# MAIL_FROM=

# Secreto para proteger tareas programadas / webhooks (reservado; hoy no se usa)
# CRON_SECRET=
