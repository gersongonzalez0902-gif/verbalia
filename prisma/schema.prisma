// VERBALIA · Esquema de datos de la Etapa 3 (terreno preparado)
// ====================================================================
// El juego en sí sigue siendo 100 % local (IndexedDB cifrada en el
// navegador): el progreso del jugador NUNCA se mueve aquí sin su
// permiso. Estos modelos son la cimentación de lo que llega ahora:
//
//   · Player / Friendship .... comunidad (perfil público, amistades,
//     tablas de honor) sobre identidad anónima de dispositivo; el
//     login por correo/OAuth se añade encima sin romper nada porque
//     esos campos irán en su propia tabla cuando existan.
//   · VaultEnvelope .......... la bóveda de respaldo cifrada deja de
//     vivir en la RAM del servidor: los sobres sobreviven reinicios.
//     Sigue siendo zero-knowledge: aquí solo caen nonce+sal+cifrado.
//   · AiConversation/AiMessage: historial del tutor con IA, para
//     retomar charlas y moderar. Las claves de la API viven SOLO en
//     el servidor (nunca en el cliente, nunca en NEXT_PUBLIC_).
//
// Desarrollo: SQLite (archivo). Producción comunitaria: cambiar
// provider a "postgresql" y regenerar — el código no cambia.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Navegante con presencia en el servidor (comunidad de la Etapa 3).
model Player {
  id          String   @id @default(cuid())
  /// Clave anónima generada en el dispositivo del jugador.
  deviceKey   String   @unique
  displayName String
  avatar      String   @default("owl")
  /// Espejo «resumido» del progreso local: solo lo público (XP, nivel,
  /// racha). El detalle de juego no se sincroniza sin permiso.
  xp          Int      @default(0)
  level       Int      @default(1)
  streak      Int      @default(0)
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  sentRequests     Friendship[]    @relation("friendshipRequester")
  receivedRequests Friendship[]    @relation("friendshipAddressee")
  conversations    AiConversation[]
}

/// Amistades entre navegantes: solicitud → aceptación.
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  /// pending | accepted | blocked
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  requester Player @relation("friendshipRequester", fields: [requesterId], references: [id])
  addressee Player @relation("friendshipAddressee", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
}

/// Sobre sellado de la bóveda: el servidor no puede abrirlo (zero-knowledge).
model VaultEnvelope {
  id         String   @id
  nonce      String
  salt       String
  ciphertext String
  storedAt   DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

/// Conversación con el tutor de IA (Léxico mayor).
model AiConversation {
  id        String   @id @default(cuid())
  /// Nulo = charla anónima sin registro.
  playerId  String?
  title     String   @default("Charla con Léxico")
  createdAt DateTime @default(now())

  player   Player?    @relation(fields: [playerId], references: [id])
  messages AiMessage[]
}

/// Turno de una conversación con el tutor.
model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  /// user | assistant | system
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
